# Settings and secrets for the public stack (docker/compose.yml). Copy to
# docker/.env (gitignored) and fill in. Setup steps: docs/hosting.md.
#
# Plain KEY=value lines: no spaces around "=", no quotes needed. The deploy
# script also reads this file with the shell, so keep values on one line.

# The public hostname the tunnel serves, without https:// (e.g. seats.example.com).
# The API only accepts browser requests from https://$PUBLIC_HOST.
PUBLIC_HOST=seats.example.com

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the
# "Install connector" command (the long string after `--token`).
TUNNEL_TOKEN=

# Clerk production instance for PUBLIC_HOST (dashboard.clerk.com → API keys).
# The publishable key is baked into the web build (it's public); the secret
# key only goes to the API.
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_

# Database password, set once: Postgres stores it when it first creates the
# data folder, so changing it later needs an ALTER USER as well. It goes into
# a URL, so use letters and digits only, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Optional. Where the database lives on the box (default below).
# PG_DATA_DIR=/DATA/AppData/seeater/pg

# Optional. web's direct port. By default only reachable from the box itself
# (127.0.0.1); set WEB_LAN_BIND=0.0.0.0 to open it to the LAN. Sign-in only
# works on PUBLIC_HOST.
# WEB_LAN_BIND=127.0.0.1
# WEB_LAN_PORT=8090

# Optional. API requests per minute per visitor IP (/api/health is exempt).
# RATE_LIMIT_MAX=300
