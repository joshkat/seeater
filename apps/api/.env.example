# Copy to .env and adjust for your local setup.

# PostgreSQL connection string used by Prisma. Matches docker-compose.yml
# (`npm run db:up`). Only the optional sync API needs a database.
DATABASE_URL="postgresql://seating:seating@localhost:5432/seating_app?schema=public"

# API server
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the web app dev server).
CORS_ORIGIN="http://localhost:5173"

# Clerk auth (https://dashboard.clerk.com → API Keys). Optional: leave blank to
# run the API without auth in local dev (owner = x-owner-id header / dev-user).
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
