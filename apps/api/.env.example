# Copy to .env and adjust for your local setup.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seating_app?schema=public"

# API server
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the web app dev server).
CORS_ORIGIN="http://localhost:5173"
