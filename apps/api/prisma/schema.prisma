// Prisma schema for the optional sync API.
//
// The app is local-first: each seating chart is one JSON "event document"
// (schema in @seating/shared) stored in the browser's IndexedDB. When a user
// signs in, documents are mirrored here, one row each, so they're backed up
// and available on other devices. The server never edits a document; it only
// stores whole versions and rejects stale writes (optimistic concurrency).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One synced event document per (owner, id).
model EventDocument {
  /// Clerk user id (or the dev owner in keyless mode).
  ownerId   String
  /// Client-generated UUID — the document's own `id`.
  id        String
  /// Denormalized from `data.name` for cheap listing.
  name      String
  /// Incremented on every accepted write; clients send it back as `baseVersion`.
  version   Int
  /// The full EventDoc JSON. Null once deleted (tombstone).
  data      Json?
  /// Set when deleted. The row is kept so other devices learn of the delete.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([ownerId, id])
  @@index([ownerId, updatedAt])
}
