// Prisma schema for the optional sync API.
//
// The app is local-first: each seating chart is one JSON "event document"
// (schema in @seating/shared) stored in the browser's IndexedDB. When a user
// signs in, documents are mirrored here, one row each, so they're backed up
// and available on other devices. The server never edits a document; it only
// stores whole versions and rejects stale writes (optimistic concurrency).

// Prisma 7: the client is generated as TypeScript into src/generated/prisma
// (gitignored; run `npm run prisma:generate`). The connection URL lives in
// prisma.config.ts, and the runtime connects through the pg driver adapter
// (src/plugins/prisma.ts).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// One synced event document. Ids are client-generated UUIDs and unique
/// across all users, so one row can be shared with other people.
model EventDocument {
  /// Client-generated UUID — the document's own `id`.
  id           String    @id
  /// Clerk user id of the owner (or the dev owner in keyless mode).
  ownerId      String
  /// Owner's display name at their last write, shown to collaborators.
  ownerName    String    @default("")
  /// Denormalized from `data.name` for cheap listing.
  name         String
  /// Incremented on every accepted write; clients send it back as `baseVersion`.
  version      Int
  /// The full EventDoc JSON. Null once deleted (tombstone).
  data         Json?
  /// Set when deleted. The row is kept so other devices learn of the delete.
  deletedAt    DateTime?
  /// Secret for the public read-only link. Regenerating replaces it.
  shareToken   String?   @unique
  /// Whether the read-only link currently works.
  shareEnabled Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members EventMember[]
  lock    EventLock?
  images  EventImage[]

  @@index([ownerId, updatedAt])
}

enum MemberRole {
  editor
  viewer
}

/// Someone the owner shared an event with. Invites are by email; `userId` is
/// filled in the first time a signed-in user with that verified email lists
/// their events.
model EventMember {
  eventId   String
  /// Lower-cased email the invite was sent to.
  email     String
  /// Clerk user id once the invite has been picked up.
  userId    String?
  role      MemberRole
  invitedBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event EventDocument @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, email])
  @@index([userId])
  @@index([email])
}

/// Advisory "one editor at a time" lock. Renewed by the editing client;
/// anyone may take over an expired lock (or force it).
model EventLock {
  eventId     String   @id
  userId      String
  displayName String
  /// Random id of the browser tab holding it, so two tabs of one user don't
  /// both think they hold it.
  clientId    String
  expiresAt   DateTime

  event EventDocument @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Floor-plan image bytes. Immutable: an id always means the same picture.
model EventImage {
  eventId   String
  id        String
  mimeType  String
  width     Int
  height    Int
  bytes     Bytes
  createdAt DateTime @default(now())

  event EventDocument @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, id])
}
