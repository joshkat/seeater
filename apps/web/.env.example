# Copy to .env.local for local development. Everything here is optional —
# with nothing set, the app is purely local (IndexedDB) with no sign-in.

# Clerk publishable key (https://dashboard.clerk.com → API Keys). Enables the
# optional "Sign in to sync" button. Leave blank for a local-only app.
VITE_CLERK_PUBLISHABLE_KEY=""

# Base URL of the optional sync API (@seating/api).
VITE_API_BASE_URL="http://localhost:4000/api"

# Keyless dev only: with no Clerk key, sync as this owner id against a keyless
# local API (sent as the x-owner-id header). Ignored when a Clerk key is set.
VITE_DEV_SYNC_OWNER=""
