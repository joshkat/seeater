{
  "name": "seating-app",
  "version": "0.1.0",
  "private": true,
  "description": "Visual event seating-chart builder (web-first, API-driven for future mobile)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @seating/shared",
    "dev:api": "npm run dev --workspace @seating/api",
    "dev:web": "npm run dev --workspace @seating/web",
    "prisma:migrate": "npm run prisma:migrate --workspace @seating/api",
    "prisma:generate": "npm run prisma:generate --workspace @seating/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
