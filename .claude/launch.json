{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 5173
    },
    {
      "name": "web-keyless",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_CLERK_PUBLISHABLE_KEY=",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@seating/web",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000
    },
    {
      "name": "web-devsync",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_ENABLE_SYNC=true",
        "VITE_CLERK_PUBLISHABLE_KEY=",
        "VITE_DEV_SYNC_OWNER=dev-user",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@seating/web",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "web-devsync-guest",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_ENABLE_SYNC=true",
        "VITE_CLERK_PUBLISHABLE_KEY=",
        "VITE_DEV_SYNC_OWNER=guest-user",
        "VITE_DEV_SYNC_NAME=Gina Guest",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@seating/web",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--workspace",
        "@seating/web",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
